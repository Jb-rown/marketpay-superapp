# UI-only build. API integration can be added behind a typed data-access layer.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Development-only, permits direct access to all MarketPay UI routes.
# Enabled by default in `npm run dev`. Set false to test the authentication guard.
MARKETPAY_UI_PREVIEW=true
NEXT_PUBLIC_MARKETPAY_UI_PREVIEW=true
